{
  "name": "durakbot-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "build:static": "VITE_BACKEND=local VITE_BASE=/DurakBot/ npm run build -- --outDir dist-static --emptyOutDir",
    "preview:static": "VITE_BACKEND=local VITE_BASE=/DurakBot/ vite preview --outDir dist-static"
  },
  "dependencies": {
    "onnxruntime-web": "1.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "playwright-core": "1.61.1",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
